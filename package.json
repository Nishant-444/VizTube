{
  "name": "viztube",
  "version": "2.0.0",
  "private": true,
  "description": "Full-stack video platform with AI video Q&A (inspired by YouTube and Twitter)",
  "keywords": [
    "nodejs",
    "prisma",
    "express",
    "nextjs",
    "rag",
    "pgvector"
  ],
  "license": "ISC",
  "author": "nishant sharma",
  "scripts": {
    "dev": "concurrently -n api,ai,web -c blue,magenta,green \"pnpm run dev:api\" \"pnpm run dev:ai\" \"pnpm run dev:web\"",
    "dev:api": "pnpm --filter @viztube/api dev",
    "dev:ai": "uv run --directory apps/ai-worker uvicorn main:app --reload --port 8000",
    "dev:web": "pnpm --filter @viztube/web dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm --filter @viztube/web lint"
  },
  "devDependencies": {
    "concurrently": "^10.0.4",
    "prettier": "^3.6.2"
  },
  "packageManager": "pnpm@11.5.2+sha512.71c631e382066efc25625d5cf029075de07b61b37f6e27350fbd84b1bda5864c8c1967adc280776b45c30a715c0359a3be08fef42d5bb09e2b99029979692916"
}
